#The most basic libraries
library(openxlsx)
library(readxl)
library(dplyr)
library(plm)
library(ggplot2)
library(broom)
library(emmeans)
library(stargazer)
library(readxl)
library(dplyr)
# -- Raw sheet has School_average & Number_of_students
raw_14_18 <- read_excel("data-2014to2018.xlsx") %>%
rename(NUTS_3 = 1) %>%        # rename first col
select(-2)                    # drop the extra column
ggplot(raw_14_18, aes(x = School_average)) +
geom_density(fill = "#4682b4", alpha = 0.6) +
facet_wrap(~ YEAR, nrow = 2) +
labs(
title = "Density of School Averages (2014–2018)",
x     = "School Average",
y     = "Density"
) +
theme_minimal(base_size = 14)
# Read post‑2020 sheet
post20   <- read_excel("data-2014to2018.xlsx", sheet = "grades_post2020") %>%
rename(NUTS_3 = 1)
ggplot(post20, aes(x = School_average)) +
geom_density(fill = "#4682b4", alpha = 0.6) +
facet_wrap(~ YEAR, nrow = 2) +
labs(
title = "Density of School Averages (2020–2024)",
x     = "School Average",
y     = "Density"
) +
theme_minimal(base_size = 14)
library(dplyr)
library(e1071)
# Group by YEAR and calculate distributional stats
annual_stats <- post20 %>%
group_by(YEAR) %>%
summarise(
mean_score = mean(School_average, na.rm = TRUE),
sd_score = sd(School_average, na.rm = TRUE),
skewness = skewness(School_average, na.rm = TRUE),
kurtosis = kurtosis(School_average, na.rm = TRUE)
)
# Show the results
print(annual_stats)
# Panel index & weighted school average
panel_14_18 <- raw_14_18 %>%
group_by(NUTS_3, YEAR) %>%
summarise(
weighted_avg_score =
weighted.mean(School_average, Number_of_students, na.rm = TRUE),
.groups = "drop"
)
# Weighted scores
panel20 <- post20 %>%
group_by(NUTS_3, YEAR) %>%
summarise(weighted_avg_score =
weighted.mean(School_average, Number_of_students, na.rm = TRUE),
.groups = "drop")
merged20 <- panel20
dim(panel_14_18)
dim(panel20)
#how many distinct regions?
table_pre <- panel_14_18 %>% summarise(n_pre = n_distinct(NUTS_3))
table_post <- panel20 %>% summarise(n_post = n_distinct(NUTS_3))
bind_rows(table_pre, table_post)
setdiff(unique(panel_14_18$NUTS_3), unique(panel20$NUTS_3))
panel_14_18[panel_14_18$NUTS_3=="София-Град",]
panel_14_18<-na.omit(panel_14_18)
dim(panel_14_18)
dim(panel20)
library(dplyr)
library(broom)
library(ggplot2)
# 1. Stack 2014–18 and 2020–23 data (remeber the expected number of observations is 290)
merged_all <- bind_rows(panel_14_18, merged20) %>%
mutate(
YEAR   = factor(YEAR),
NUTS_3 = factor(NUTS_3)
)
dim(merged_all)
# 2. Fit year + region FE model (no intercept → direct level estimates)
fe_model <- lm(weighted_avg_score ~ 0 + YEAR+NUTS_3, data = merged_all)
# 3. Extract coeffs
year_coefs <- tidy(fe_model) %>%
filter(startsWith(term, "YEAR")) %>%
transmute(
x        = as.integer(sub("YEAR", "", term)),
estimate = estimate,
se       = std.error
)
# 4. Plot year effects, connected by a line
ggplot(year_coefs, aes(x = x, y = estimate)) +
geom_line() +
geom_point() +
geom_errorbar(aes(
ymin = estimate - 1.96 * se,
ymax = estimate + 1.96 * se
), width = 0.2) +
scale_x_continuous(breaks = year_coefs$x) +
labs(
x     = "Year",
y     = "Weighted avg. score",
title = "Annual weighted_avg_score\n(controlling for NUTS_3 FE)"
) +
theme_minimal()
# 5. Extract region coeffs
region_coefs <- tidy(fe_model) %>%
filter(startsWith(term, "NUTS_3")) %>%
transmute(
x        = sub("NUTS_3", "", term),
estimate = estimate,
se       = std.error
)
# 6. Plot region effects, connected by a line
ggplot(region_coefs, aes(x = x, y = estimate, group = 1)) +
geom_line() +
geom_point() +
geom_errorbar(aes(
ymin = estimate - 1.96 * se,
ymax = estimate + 1.96 * se
), width = 0.2) +
labs(
x     = "NUTS_3 Region",
y     = "Region fixed effect",
title = "NUTS_3 fixed effects\n(controlling for Year FE)"
) +
theme_minimal() +
theme(axis.text.x = element_text(angle = 90, hjust = 1))
# Export to Excel
#this is used only to check stuff for correctness
#write.xlsx(merged_all, file = "merged_all.xlsx")
# Bind school-level data
merged_schools <- bind_rows(post20, raw_14_18)
fe_model <- lm(weighted_avg_score ~ 0 + YEAR+NUTS_3, data = merged_all)
# Estimate baseline SD for pre-COVID years
baseline_sd <- sd(merged_schools$School_average[as.numeric(as.character(merged_schools$YEAR)) < 2020], na.rm = TRUE)
# Extract YEAR fixed effects
coefs <- coef(fe_model)
year_coefs <- coefs[grep("^YEAR", names(coefs))]
# Clean up year labels
years <- as.numeric(gsub("as.factor\\(YEAR\\)", "", names(year_coefs)))
names(years) <- names(year_coefs)
year_coefs <- year_coefs[order(years)]
# Compute changes
raw_changes <- diff(year_coefs)
std_changes <- raw_changes / baseline_sd
year_pairs <- paste0(names(year_coefs)[-length(year_coefs)], "-", names(year_coefs)[-1])
# Create final output
result <- data.frame(
Year = year_pairs,
Raw_Change = round(raw_changes, 3),
Std_Change = round(std_changes, 3)
)
# Print YEAR fixed effects separately
cat("Estimated YEAR Fixed Effects (adjusted for NUTS_3):\n")
print(round(year_coefs, 3))
# Print SD used
cat("\nBaseline SD of School_average (2014–2018):", round(baseline_sd, 3), "\n\n")
# Print table
cat("Year-to-Year Changes (raw and standardized):\n")
print(result)
# Step 1: Estimate the model
fe_model_School_level <- lm(School_average ~ 0 + as.factor(YEAR),
data = merged_schools,
weights = Number_of_students)
# Step 2: Extract and clean year coefficients
coefs <- coef(fe_model_School_level)
year_labels <- names(coefs)
years <- as.numeric(gsub("as.factor\\(YEAR\\)", "", year_labels))
# Step 3: Sort both together
sorted_index <- order(years)
coefs <- coefs[sorted_index]
years <- years[sorted_index]
# Step 4: Compute raw and standardized changes
changes <- diff(coefs)
standardized_changes <- changes / baseline_sd
year_pairs <- paste0(years[-length(years)], "-", years[-1])
# Step 5: Output
result_school <- data.frame(
Year = year_pairs,
Raw_Change = round(changes, 3),
Std_Change = round(standardized_changes, 3)
)
print(result_school)
#write.xlsx(merged_all, file = "merged_all.xlsx")
library(readxl)
library(dplyr)
# 1. Load exam scores
exam <- merged_all %>%
mutate(NUTS_3 = as.factor(NUTS_3),
YEAR   = as.factor(YEAR))
# 2. Load macro indicators 2014–2018
macro_14_18 <- read_excel("data-2014to2018.xlsx", sheet = "MAIN_SOURCE") %>%
mutate(NUTS_3 = as.factor(NUTS_3),
YEAR   = as.factor(YEAR))
# 3. Load GDP for 2014–2018
gdp_14_18 <- read_excel("data-2014to2018.xlsx", sheet = "GDPpercap_pre_COVID") %>%
mutate(NUTS_3 = as.factor(NUTS_3),
YEAR   = as.factor(YEAR))
# 4. Load GDP for 2020–2024
gdp_20up <- read_excel("data-2014to2018.xlsx", sheet = "GDPpercap_post_COVID") %>%
mutate(NUTS_3 = as.factor(NUTS_3),
YEAR   = as.factor(YEAR))
# 5. Combine GDP datasets into one
gdp_all <- bind_rows(gdp_14_18, gdp_20up)
# 6. Merge macro + GDP
macro_full <- macro_14_18 %>%
left_join(gdp_all, by = c("NUTS_3", "YEAR"))
# 7. Merge with exam panel
panel_data <- exam %>%
left_join(macro_full, by = c("NUTS_3", "YEAR"))
# 8. Inspect
head(panel_data)
panel_data<-na.omit(panel_data)
dim(panel_data)
library(dplyr)
library(plm)
# 1. Create post dummy + interaction
panel_data <- panel_data %>%
mutate(
YEAR = as.integer(as.character(YEAR)),  # fix factor → integer FIRST
grades_post2020 = ifelse(YEAR >= 2020, 1, 0),
GDP_post = log(GDP_PER_CAPITA) * grades_post2020,
internet_post=log(households_with_internet / enrolled_students_total)* grades_post2020
)
# 2. Declare panel structure
pdata <- pdata.frame(panel_data, index = c("NUTS_3", "YEAR"))
# 3. One-way FE regression
fe_model <- plm(
log(weighted_avg_score) ~ log(GDP_PER_CAPITA) +GDP_post +
share_higher_education_25_64 +
internet_post,
data = pdata,
model = "within",
effect = "time"
)
stargazer::stargazer(fe_model, type="text")
# Ensure YEAR is numeric first
panel_data$YEAR <- as.integer(as.character(panel_data$YEAR))
# Pre-COVID (2015–2019 or 2014–2019 depending on your data)
panel_data_2015_2018 <- panel_data[panel_data$YEAR < 2020, ]
# Post-COVID (2020–2023 or 2020–2024 depending on your data)
panel_data_2020_2023 <- panel_data[panel_data$YEAR >= 2020, ]
# Make sure YEAR is numeric
panel_data$YEAR <- as.integer(as.character(panel_data$YEAR))
# Split data
panel_data_2015_2018 <- subset(panel_data, YEAR < 2020)
panel_data_2020_2023 <- subset(panel_data, YEAR >= 2020)
# Select variables for correlation
vars <- c("weighted_avg_score", "GDP_PER_CAPITA",
"share_higher_education_25_64", "households_with_internet")
# Correlations pre-COVID
cor_pre <- cor(panel_data_2015_2018[vars], use = "pairwise.complete.obs")
print("Correlation matrix (pre-COVID, < 2020)")
round(cor_pre, 3)
# Correlations post-COVID
cor_post <- cor(panel_data_2020_2023[vars], use = "pairwise.complete.obs")
print("Correlation matrix (post-COVID, >= 2020)")
round(cor_post, 3)
