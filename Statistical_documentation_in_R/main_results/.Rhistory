library(plm)
library(lmtest)
library(sandwich)
library(stargazer)
# Models
model <- plm(
log(weighted_avg_score) ~ log(GDP_PER_CAPITA),
data = the_whole_thing,
effect = "twoways",
model  = "within",
index  = c("NUTS_3","YEAR")
)
model4 <- plm(
log(weighted_avg_score) ~ log(GDP_PER_CAPITA) +
share_higher_education_25_64 +
log(households_with_internet / enrolled_students_total),
data = the_whole_thing,
effect = "twoways",
model  = "within",
index  = c("NUTS_3","YEAR")
)
# Cluster-robust vcov by group (NUTS_3)
V1 <- vcovHC(model, method = "arellano", type = "HC1", cluster = "group")
V4 <- vcovHC(model4,method = "arellano", type = "HC1", cluster = "group")
# Get coef tables with aligned SEs
ct1 <- coeftest(model,  vcov. = V1)
ct4 <- coeftest(model4, vcov. = V4)
# Extract robust SEs (names align with coef names)
se1 <- ct1[, "Std. Error"]
se4 <- ct4[, "Std. Error"]
stargazer(
model, model4,
type = "text",
se   = list(se1, se4),
title = "FE (Two-ways) with Cluster-Robust SEs by NUTS_3",
dep.var.labels = "log(weighted_avg_score)",
omit.stat = c("ser")
)
coeftest(model,  vcov. = V1)
coeftest(model4, vcov. = V4)
# Models
model <- plm(
log(weighted_avg_score) ~ log(GDP_PER_CAPITA),
data = the_whole_thing,
effect = "twoways",
model  = "within",
index  = c("NUTS_3","YEAR")
)
model4 <- plm(
log(weighted_avg_score) ~ log(GDP_PER_CAPITA) +
share_higher_education_25_64 +
log(households_with_internet / enrolled_students_total),
data = the_whole_thing,
effect = "twoways",
model  = "within",
index  = c("NUTS_3","YEAR")
)
stargazer::stargazer(model,model4, type="text")
coeftest(model)
coeftest(model,  vcov. = V1)
