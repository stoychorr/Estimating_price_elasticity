stargazer(
test_model,
type = "text",
se = list(test_se),
omit.stat = c("ser")
)
library(plm)
test_model <- plm(
log_app ~ c_YouthUnempl,
data = panel_wb_sat,
effect = "twoways",
model = "within",
index = c("Domicile_named_country", "Year")
)
test_V <- vcovHC(
test_model,
method = "arellano",
type = "HC1",
cluster = "group"
)
test_ct <- coeftest(
test_model,
vcov. = test_V
)
test_se <- test_ct[, "Std. Error"]
test_ct
stargazer::stargazer(
test_model,
type = "text",
se = list(test_se),
omit.stat = c("ser")
)
