# Saturated DiD table
# ------------------------------------------------------------
etable(
sat_baseline$weighted,
sat_baseline$unweighted,
sat_poor$weighted,
sat_poor$unweighted,
sat_rich$weighted,
sat_rich$unweighted,
sat_oecd$weighted,
sat_oecd$unweighted,
sat_ireland_only,
headers = c(
"Baseline weighted",
"Baseline unweighted",
"Poor weighted",
"Poor unweighted",
"Rich weighted",
"Rich unweighted",
"OECD weighted",
"OECD unweighted",
"Ireland only"
),
fitstat = ~ n + ar2 + wr2,
tex = FALSE
)
# ------------------------------------------------------------
# Saturated DiD coefficient heatmap
# All countries × all models in one figure
# ------------------------------------------------------------
library(dplyr)
library(broom)
library(stringr)
library(ggplot2)
library(forcats)
# Collect all saturated models
saturated_models <- list(
"Baseline weighted"   = sat_baseline$weighted,
"Baseline unweighted" = sat_baseline$unweighted,
"Poor weighted"       = sat_poor$weighted,
"Poor unweighted"     = sat_poor$unweighted,
"Rich weighted"       = sat_rich$weighted,
"Rich unweighted"     = sat_rich$unweighted,
"OECD weighted"       = sat_oecd$weighted,
"OECD unweighted"     = sat_oecd$unweighted,
"Ireland only"        = sat_ireland_only
)
# Function to extract saturated coefficients from one model
extract_sat_coefs <- function(model, model_name) {
tidy(model, conf.int = TRUE) %>%
filter(str_detect(term, "treated_factor::.*:Post")) %>%
mutate(
model = model_name,
country = term %>%
str_replace("treated_factor::", "") %>%
str_replace(":Post", ""),
significant = ifelse(conf.low > 0 | conf.high < 0, 1, 0)
) %>%
select(
model,
country,
estimate,
std.error,
conf.low,
conf.high,
significant
)
}
# Bind all model coefficients
sat_all_plot_data <- bind_rows(
lapply(names(saturated_models), function(x) {
extract_sat_coefs(saturated_models[[x]], x)
})
)
# Order countries by average estimated effect across all models
country_order <- sat_all_plot_data %>%
group_by(country) %>%
summarise(
mean_estimate = mean(estimate, na.rm = TRUE),
.groups = "drop"
) %>%
arrange(mean_estimate) %>%
pull(country)
# Order models in the exact order we want
model_order <- c(
"Baseline weighted",
"Baseline unweighted",
"Poor weighted",
"Poor unweighted",
"Rich weighted",
"Rich unweighted",
"OECD weighted",
"OECD unweighted",
"Ireland only"
)
sat_all_plot_data <- sat_all_plot_data %>%
mutate(
country = factor(country, levels = rev(country_order)),
model = factor(model, levels = model_order),
sig_label = ifelse(significant == 1, "CI excludes zero", "CI includes zero")
)
library(dplyr)
library(broom)
library(stringr)
library(ggplot2)
library(ggrepel)
models <- list(
"Baseline W" = sat_baseline$weighted,
"Baseline U" = sat_baseline$unweighted,
"Poor W" = sat_poor$weighted,
"Poor U" = sat_poor$unweighted,
"Rich W" = sat_rich$weighted,
"Rich U" = sat_rich$unweighted,
"OECD W" = sat_oecd$weighted,
"OECD U" = sat_oecd$unweighted,
"Ireland" = sat_ireland_only
)
sat <- bind_rows(lapply(names(models), function(m) {
tidy(models[[m]], conf.int = TRUE) %>%
filter(str_detect(term, "treated_factor::.*:Post")) %>%
mutate(
model = m,
country = str_replace_all(term, "treated_factor::|:Post", "")
)
}))
sat$model <- factor(sat$model, levels = names(models))
ranked <- sat %>%
group_by(country) %>%
summarise(avg = mean(estimate), .groups = "drop") %>%
arrange(avg)
low <- ranked$country[1]
high <- ranked$country[nrow(ranked)]
sat <- sat %>%
mutate(group = case_when(
country == low ~ "Lowest",
country == high ~ "Highest",
TRUE ~ "Other"
))
avg <- sat %>%
group_by(model) %>%
summarise(estimate = mean(estimate), .groups = "drop") %>%
mutate(country = "AVERAGE", group = "Average")
labels <- bind_rows(
sat %>% filter(country %in% c(low, high), model == "Ireland"),
avg %>% filter(model == "Ireland")
)
ggplot() +
geom_hline(yintercept = 0, linetype = "dashed", colour = "grey40") +
geom_line(
data = sat %>% filter(group == "Other"),
aes(model, estimate, group = country),
colour = "grey75",
alpha = 0.5
) +
geom_line(
data = sat %>% filter(group != "Other"),
aes(model, estimate, group = country, colour = group),
linewidth = 1.3
) +
geom_line(
data = avg,
aes(model, estimate, group = country, colour = group),
linewidth = 1.5
) +
geom_point(
data = sat %>% filter(group != "Other"),
aes(model, estimate, colour = group),
size = 2.4
) +
geom_point(
data = avg,
aes(model, estimate, colour = group),
size = 2.6
) +
geom_text_repel(
data = labels,
aes(model, estimate, label = country, colour = group),
nudge_x = 0.4,
hjust = 0,
show.legend = FALSE
) +
scale_colour_manual(values = c(
"Lowest" = "#8B0000",
"Highest" = "#2166AC",
"Average" = "black"
)) +
coord_cartesian(clip = "off") +
labs(
title = "Saturated DiD robustness",
subtitle = "Lowest, highest, and average trajectories",
x = NULL,
y = "Effect on log applicants",
colour = NULL
) +
theme_classic(base_size = 11) +
theme(
axis.text.x = element_text(angle = 45, hjust = 1),
legend.position = "bottom",
plot.margin = margin(10, 80, 10, 10)
)
